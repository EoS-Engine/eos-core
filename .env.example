# Copy this file to .env and fill in real local values.
# .env is gitignored and must never be committed.

# Used by docker-compose.yml to initialize the SQL Server container.
MSSQL_SA_PASSWORD=Replace-With-A-Strong-Local-Password-1

# Consumed by EOS.Infrastructure (WP-004) to connect to each store.
EOS_SQLSERVER_CONNECTION_STRING=Server=localhost,1433;Database=master;User Id=sa;Password=Replace-With-A-Strong-Local-Password-1;TrustServerCertificate=True
EOS_REDIS_CONNECTION_STRING=localhost:6379
EOS_CHROMADB_ENDPOINT=http://localhost:8000

# Host directory for bind-mounted container data (SQL Server, Redis, ChromaDB).
EOS_DATA_DIR=/home/YOUR_USER/eos/data
